# Your final public domain. Do not leave the example URL when deploying.
NEXT_PUBLIC_SITE_URL=https://alltoolkit.org

# Optional: paste the verification token from Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Google AdSense publisher ID, for example ca-pub-1234567890123456.
# Leave blank until your AdSense account is approved.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional responsive ad-unit slot IDs created inside AdSense.
NEXT_PUBLIC_ADSENSE_HOME_TOP_SLOT=
NEXT_PUBLIC_ADSENSE_HOME_MIDDLE_SLOT=
NEXT_PUBLIC_ADSENSE_HOME_BOTTOM_SLOT=
NEXT_PUBLIC_ADSENSE_TOOL_TOP_SLOT=
NEXT_PUBLIC_ADSENSE_TOOL_BOTTOM_SLOT=
